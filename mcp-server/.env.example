# Copy to .env and fill in values before deploying.
# Never commit .env to version control.

# Required: shared secret clients must send as "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# Optional overrides
PORT=3000
RATE_LIMIT_MAX=100

# Uncomment to mount a local repo clone instead of using the image-baked copy
# LOCAL_REPO_PATH=/path/to/local/Anthropic-Cybersecurity-Skills
